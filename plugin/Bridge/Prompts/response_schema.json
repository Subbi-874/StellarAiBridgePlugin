    "reply_text": {
      "type": "string",
      "description": "Natural Korean reply for in-game chat (plain text without markdown; can be short or detailed — automatically split into 140-character chat messages when long)."
    },
    "sticker": {
      "type": "string",
      "description": "Optional built-in game picture sticker mood tag or ID to send in chat (e.g. 'greet', 'thanks', 'thumbsup', 'cheer', 'heart', 'laugh', 'cute', 'ok', 'think', 'sorry', 'sad', or '' to omit)."
