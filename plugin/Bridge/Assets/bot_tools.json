          "type": "string",
          "description": "이동할 지역/거점 이름 (teleport_to_place용)"
        },
        "line_id": {
          "type": "integer",
          "description": "이동할 채널 번호 (switch_channel용)"
        },
        "monster": {
          "type": "string",
          "description": "찾아갈 몬스터 이름 또는 ID (seek_monster용)"
        },
        "engage": {
          "type": "boolean",
          "description": "seek_monster 도착 후 자동전투 여부"
        },
        "gimmick": {
          "type": "string",
          "description": "사용할 이동 기믹 이름/키워드 (use_gimmick용)"
        },
        "continuous": {
          "type": "boolean",
          "description": "follow_player 지속 추적 여부 (기본 true)"
        },
        "category": {
          "type": "string",
          "description": "자동 퀘스트 카테고리 (auto_quest용: 구역 퀘스트, 스토리, 후일담, 가이드 퀘스트, 인연 스토리, 이벤트 퀘스트, 전체)"
        },
        "region": {
          "type": "string",
          "description": "우선 처리할 지역/맵 이름 (auto_quest용, 예: 바하마르 고원, 아스테리아 평원, 아스텔리즈, 현재 지역 — '○○ 지역 먼저 해' 시 지정)"
        },
        "region_only": {
          "type": "boolean",
          "description": "true면 지정한 region의 퀘스트만 수행, false(기본)면 해당 지역을 최우선 처리 후 나머지 진행 (auto_quest용)"
        },
        "quest": {
          "type": "string",
          "description": "특정 퀘스트 이름 검색어 (auto_quest용, 비우면 카테고리 위에서부터 순차 진행)"
        },
        "max_quests": {
          "type": "integer",
          "description": "진행할 최대 퀘스트 개수 (auto_quest용, 0 또는 생략 시 해당 카테고리 모두 순차 진행)"
        }
      },
      "required": [
        "action"
      ]
    }
  },
