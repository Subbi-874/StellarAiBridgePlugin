[
  {
    "name": "inspect_game_info",
    "description": "게임 내 읽기 전용 정보(상태, 로스터, 파티, 특정 유저 위치, 던전 목록, 채집물, 낚시터, 이동 기믹, 직업 프리셋, 의상, 감정표현, 활성 목표, 기억, 알고 있는 유저)를 조회합니다.",
    "parameters": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "description": "조회 대상 종류",
          "enum": [
            "status",
            "roster",
            "party",
            "player_location",
            "dungeons",
            "gatherables",
            "fishing_spots",
            "gimmicks",
            "loadouts",
            "outfits",
            "emotes",
            "quests",
            "goals",
            "memories",
            "known_users"
          ]
        },
        "query": {
          "type": "string",
          "description": "선택 검색어 또는 대상 이름/UID (player_location, gatherables, quests, memories 등에 사용)"
        },
        "category": {
          "type": "string",
          "description": "퀘스트 카테고리 필터 (quests 조회 시: 구역 퀘스트, 스토리, 후일담, 가이드 퀘스트, 인연 스토리, 이벤트 퀘스트, 전체)"
        },
        "region": {
          "type": "string",
          "description": "퀘스트 지역/맵 필터 또는 우선 정렬 기준 (quests 조회 시: 바하마르 고원, 아스테리아 평원, 아스텔리즈, 현재 지역 등)"
        },
        "region_only": {
          "type": "boolean",
          "description": "quests 조회 시 region에 해당하는 지역 퀘스트만 반환할지 여부 (기본 false)"
        }
      },
      "required": [
        "kind"
      ]
    }
  },
  {
    "name": "inspect_craft",
    "description": "제작 목표 시작 전 레시피 검색, 가방 아이템 수량/집중력 확인, 또는 재료 트리 및 부족분 계획을 조회합니다.",
    "parameters": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "description": "조회 모드",
          "enum": [
            "plan_craft",
            "recipe",
            "item_count"
          ]
        },
        "query": {
          "type": "string",
          "description": "아이템 또는 레시피 이름"
        },
        "recipe_id": {
          "type": "integer",
          "description": "레시피 ID 또는 item_count의 item_id"
        },
        "count": {
          "type": "integer",
          "description": "목표 수량 또는 제작 횟수 (0이면 집중력/생활력 소진까지, 기본 1)"
        },
        "count_mode": {
          "type": "string",
          "description": "수량 기준: additional(완성품 N개 추가), total_target(총 N개 보유 목표), crafts(제작 N번/N회 실행), max_focus(집중력/생활력 소진까지 최대 제작)",
          "enum": [
            "additional",
            "total_target",
            "crafts",
            "max_focus"
          ]
        }
      },
      "required": [
        "mode"
      ]
    }
  },
  {
    "name": "move_or_navigate",
    "description": "캐릭터 이동 및 위치 제어(대상 따라가기, 거점 순간이동, 채널 이동, 던전 퇴장, 몬스터 찾기, 이동 기믹 사용, 모든 행동 중지)를 실행합니다.",
