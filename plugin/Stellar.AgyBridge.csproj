<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Stellar.AgyBridge</RootNamespace>
    <AssemblyName>Stellar.AgyBridge</AssemblyName>
    <Version>0.1.0</Version>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stellar.Abstractions" Version="2.32.0" />
    <PackageReference Include="Stellar.Plugin.InteropRefs" Version="2.32.0" />
  </ItemGroup>
</Project>
